# Normalize line endings for all text files to LF in the repo
# (Windows will still use CRLF locally, but Git will store LF)
* text=auto eol=lf

# Force these to always be LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf

# Treat image/binary files as binary (no line-ending conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
